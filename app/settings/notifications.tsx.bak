import { useState } from 'react';
import { View, Text, TouchableOpacity, ScrollView, Switch } from 'react-native';
import { router } from 'expo-router';
import { useColors } from '@/hooks/use-colors';
import { ScreenContainer } from '@/components/screen-container';

const ACCENT = '#E63946';

const TOGGLES = [
  { key: 'bookingConfirmations', label: 'Booking Confirmations', desc: 'Get notified when a booking is confirmed or cancelled' },
  { key: 'reminders', label: 'Check-in Reminders', desc: 'Reminders before your upcoming stays' },
  { key: 'reviewReminders', label: 'Review Reminders', desc: 'Reminders to leave a review after your stay' },
  { key: 'promotions', label: 'Promotions & Offers', desc: 'Special deals and promotional offers' },
  { key: 'priceDrops', label: 'Price Drops', desc: 'Get notified when prices drop on saved properties' },
  { key: 'recommendations', label: 'Recommendations', desc: 'Personalized property recommendations' },
];

const EMAIL_TOGGLES = [
  { key: 'emailBooking', label: 'Booking Updates via Email', desc: 'Receive booking confirmations and updates by email' },
  { key: 'emailMarketing', label: 'Marketing Emails', desc: 'Receive newsletters and promotional emails' },
];

export default function NotificationsScreen() {
  const colors = useColors();
  const [settings, setSettings] = useState<Record<string, boolean>>({
    bookingConfirmations: true,
    reminders: true,
    reviewReminders: true,
    promotions: false,
    priceDrops: true,
    recommendations: false,
    emailBooking: true,
    emailMarketing: false,
  });

  const toggle = (key: string) => {
    setSettings(prev => ({ ...prev, [key]: !prev[key] }));
  };

  return (
    <ScreenContainer className="flex-1 bg-background">
      <ScrollView showsVerticalScrollIndicator={false}>
        <View className="px-6 pt-14 pb-8">
          <View className="flex-row items-center gap-3 mb-6">
            <TouchableOpacity onPress={() => router.back()}
              style={{ width: 40, height: 40, borderRadius: 12, backgroundColor: colors.surface, alignItems: 'center', justifyContent: 'center' }}
            >
              <Text className="text-lg">←</Text>
            </TouchableOpacity>
            <Text className="text-2xl font-bold text-foreground">Notifications</Text>
          </View>

          <View className="mb-6" style={{ borderRadius: 16, backgroundColor: colors.surface, overflow: 'hidden' }}>
            <View style={{ paddingHorizontal: 16, paddingVertical: 12, borderBottomWidth: 1, borderBottomColor: colors.border }}>
              <Text className="text-sm font-bold text-foreground">Push Notifications</Text>
              <Text className="text-xs text-muted mt-0.5">Control which notifications you receive on your device</Text>
            </View>
            {TOGGLES.map((item, index) => (
              <View key={item.key}
                style={{
                  flexDirection: 'row', alignItems: 'center', paddingVertical: 12, paddingHorizontal: 16,
                  borderBottomWidth: index < TOGGLES.length - 1 ? 1 : 0,
                  borderBottomColor: colors.border,
                }}
              >
                <View className="flex-1 pr-4">
                  <Text className="text-sm font-semibold text-foreground">{item.label}</Text>
                  <Text className="text-xs text-muted mt-0.5">{item.desc}</Text>
                </View>
                <Switch
                  value={settings[item.key]}
                  onValueChange={() => toggle(item.key)}
                  trackColor={{ false: colors.border, true: ACCENT + '60' }}
                  thumbColor={settings[item.key] ? ACCENT : '#f4f3f4'}
                />
              </View>
            ))}
          </View>

          <View style={{ borderRadius: 16, backgroundColor: colors.surface, overflow: 'hidden' }}>
            <View style={{ paddingHorizontal: 16, paddingVertical: 12, borderBottomWidth: 1, borderBottomColor: colors.border }}>
              <Text className="text-sm font-bold text-foreground">Email Notifications</Text>
              <Text className="text-xs text-muted mt-0.5">Manage email communication preferences</Text>
            </View>
            {EMAIL_TOGGLES.map((item, index) => (
              <View key={item.key}
                style={{
                  flexDirection: 'row', alignItems: 'center', paddingVertical: 12, paddingHorizontal: 16,
                  borderBottomWidth: index < EMAIL_TOGGLES.length - 1 ? 1 : 0,
                  borderBottomColor: colors.border,
                }}
              >
                <View className="flex-1 pr-4">
                  <Text className="text-sm font-semibold text-foreground">{item.label}</Text>
                  <Text className="text-xs text-muted mt-0.5">{item.desc}</Text>
                </View>
                <Switch
                  value={settings[item.key]}
                  onValueChange={() => toggle(item.key)}
                  trackColor={{ false: colors.border, true: ACCENT + '60' }}
                  thumbColor={settings[item.key] ? ACCENT : '#f4f3f4'}
                />
              </View>
            ))}
          </View>
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
