/**
 * Self-Service Check-out Screen (SRS CI-005)
 * Allows guests to check out via the portal and view their final folio
 */

import React, { useState } from 'react';
import { View, Text, TouchableOpacity, ScrollView, Alert } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';
import { useAuth } from '@/lib/context/auth-context';
import { useBookings } from '@/lib/context/booking-context';
import { useCRM } from '@/lib/context/crm-context';
import type { GuestProfile } from '@/types/api';

const ACCENT = '#E63946';

export default function SelfCheckoutScreen() {
  const colors = useColors();
  const { user } = useAuth();
  const { bookings, updateBooking } = useBookings();
  const { earnPoints } = useCRM();
  const guest = user as GuestProfile | null;

  const [selectedBookingId, setSelectedBookingId] = useState<string | null>(null);
  const [step, setStep] = useState<'select' | 'review' | 'complete'>('select');

  const checkedInBookings = bookings.filter(
    b => b.status === 'upcoming' && new Date(b.checkIn) <= new Date()
  );
  const selectedBooking = selectedBookingId
    ? bookings.find(b => b.id === selectedBookingId)
    : null;

  const formatDate = (dateStr: string) =>
    new Date(dateStr).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });

  const handleCompleteCheckout = () => {
    if (!selectedBooking) return;

    // Award loyalty points for self check-out
    if (guest?.id) {
      earnPoints(guest.id, 30);
    }

    // Mark booking as completed
    updateBooking(selectedBooking.id, { status: 'completed' });

    setStep('complete');

    Alert.alert(
      'Check-out Complete!',
      `You have been checked out successfully.\n\n30 bonus loyalty points awarded!\n\n🧹 Housekeeping has been notified.\n\nYour receipt has been sent to your registered email.`,
      [{ text: 'Done' }]
    );
  };

  const calculateTotalCharges = (b: typeof selectedBooking) => {
    if (!b) return 0;
    const folioTotal = (b.folio || []).reduce((s, c) => s + c.amount, 0);
    return b.totalPrice + folioTotal;
  };

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 40 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center gap-3 mb-6">
            <TouchableOpacity onPress={() => router.back()}
              style={{ width: 40, height: 40, borderRadius: 12, backgroundColor: colors.surface, alignItems: 'center', justifyContent: 'center' }}
            >
              <Text className="text-lg">←</Text>
            </TouchableOpacity>
            <View>
              <Text className="text-2xl font-bold text-foreground">Self Check-out</Text>
              <Text className="text-sm text-muted">Check out quickly from your phone</Text>
            </View>
          </View>

          {/* Progress Steps */}
          <View className="flex-row items-center mb-8 px-2">
            {(['select', 'review', 'complete'] as const).map((s, i) => (
              <React.Fragment key={s}>
                <View className="items-center">
                  <View style={{
                    width: 36, height: 36, borderRadius: 18,
                    backgroundColor: step === s ? ACCENT : step !== 'select' && i < ['select', 'review', 'complete'].indexOf(step) ? '#10B981' : colors.border,
                    alignItems: 'center', justifyContent: 'center',
                  }}>
                    <Text className="text-sm font-bold text-white">{i + 1}</Text>
                  </View>
                  <Text className="text-[10px] text-muted mt-1">{s === 'select' ? 'Stay' : s === 'review' ? 'Review' : 'Done'}</Text>
                </View>
                {i < 2 && <View style={{ flex: 1, height: 2, backgroundColor: i < ['select', 'review', 'complete'].indexOf(step) ? '#10B981' : colors.border, marginHorizontal: 4 }} />}
              </React.Fragment>
            ))}
          </View>

          {step === 'select' && (
            <View>
              <Text className="text-lg font-bold text-foreground mb-4">Select Your Current Stay</Text>
              {checkedInBookings.length === 0 ? (
                <View style={{ padding: 32, borderRadius: 20, backgroundColor: colors.surface, alignItems: 'center' }}>
                  <Text className="text-3xl mb-3">🏨</Text>
                  <Text className="text-sm text-muted text-center">No active stays found.</Text>
                  <Text className="text-xs text-muted text-center mt-1">
                    You don't have any checked-in bookings. Check-in first to see your stay here.
                  </Text>
                  <TouchableOpacity onPress={() => router.push('/(tabs)/self-checkin')}
                    style={{ marginTop: 16, paddingHorizontal: 24, paddingVertical: 12, borderRadius: 12, backgroundColor: ACCENT }}>
                    <Text className="text-sm font-semibold text-white">Go to Check-in</Text>
                  </TouchableOpacity>
                </View>
              ) : (
                checkedInBookings.map(b => {
                  const nights = Math.max(1, Math.ceil(
                    (new Date(b.checkOut).getTime() - new Date(b.checkIn).getTime()) / (1000 * 60 * 60 * 24)
                  ));
                  return (
                    <TouchableOpacity key={b.id} onPress={() => { setSelectedBookingId(b.id); setStep('review'); }}
                      style={{
                        padding: 16, borderRadius: 18, marginBottom: 12,
                        backgroundColor: colors.surface, borderWidth: 1.5,
                        borderColor: selectedBookingId === b.id ? ACCENT : colors.border,
                      }}
                    >
                      <View className="flex-row gap-3">
                        <View style={{ width: 64, height: 64, borderRadius: 14, backgroundColor: ACCENT + '15', alignItems: 'center', justifyContent: 'center' }}>
                          <Text style={{ fontSize: 28 }}>🏨</Text>
                        </View>
                        <View className="flex-1">
                          <Text className="text-sm font-bold text-foreground">{b.hotelName}</Text>
                          <Text className="text-xs text-muted">{b.hotelCity}, {b.hotelCountry}</Text>
                          <Text className="text-xs text-muted mt-1">
                            {formatDate(b.checkIn)} — {formatDate(b.checkOut)}
                          </Text>
                          <Text className="text-xs text-muted">
                            {b.roomTypeName} · {nights} night{nights > 1 ? 's' : ''} · {b.guests} guest{b.guests > 1 ? 's' : ''}
                          </Text>
                          {b.folio && b.folio.length > 0 && (
                            <Text className="text-xs mt-1 font-semibold" style={{ color: '#F59E0B' }}>
                              +{b.folio.length} folio charge{b.folio.length > 1 ? 's' : ''}
                            </Text>
                          )}
                        </View>
                        <Text className="text-lg text-muted self-center">›</Text>
                      </View>
                    </TouchableOpacity>
                  );
                })
              )}
            </View>
          )}

          {step === 'review' && selectedBooking && (
            <View>
              <Text className="text-lg font-bold text-foreground mb-4">Review Your Bill</Text>

              {/* Booking Details */}
              <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border, marginBottom: 16 }}>
                <Text className="text-sm font-bold text-foreground mb-3">Stay Details</Text>
                <View className="gap-2">
                  <View className="flex-row justify-between">
                    <Text className="text-sm text-muted">Hotel</Text>
                    <Text className="text-sm font-semibold text-foreground">{selectedBooking.hotelName}</Text>
                  </View>
                  <View className="flex-row justify-between">
                    <Text className="text-sm text-muted">Room</Text>
                    <Text className="text-sm font-semibold text-foreground">{selectedBooking.roomTypeName}</Text>
                  </View>
                  <View className="flex-row justify-between">
                    <Text className="text-sm text-muted">Check-in</Text>
                    <Text className="text-sm font-semibold text-foreground">{formatDate(selectedBooking.checkIn)}</Text>
                  </View>
                  <View className="flex-row justify-between">
                    <Text className="text-sm text-muted">Check-out</Text>
                    <Text className="text-sm font-semibold text-foreground">{formatDate(selectedBooking.checkOut)}</Text>
                  </View>
                </View>
              </View>

              {/* Folio Charges */}
              <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border, marginBottom: 16 }}>
                <Text className="text-sm font-bold text-foreground mb-3">Folio Breakdown</Text>
                <View className="gap-2 mb-3">
                  <View className="flex-row justify-between">
                    <Text className="text-sm text-muted">Room Charges</Text>
                    <Text className="text-sm font-semibold text-foreground">NPR {selectedBooking.totalPrice.toLocaleString()}</Text>
                  </View>
                  {(selectedBooking.folio || []).length === 0 ? (
                    <Text className="text-xs text-muted italic">No extra charges during your stay</Text>
                  ) : (
                    selectedBooking.folio!.map((charge, i) => (
                      <View key={charge.id} className="flex-row justify-between">
                        <Text className="text-sm text-muted">{charge.description}</Text>
                        <Text className="text-sm font-semibold text-foreground">NPR {charge.amount.toLocaleString()}</Text>
                      </View>
                    ))
                  )}
                </View>
                <View className="border-t border-border pt-3 flex-row justify-between">
                  <Text className="text-base font-bold text-foreground">Total</Text>
                  <Text className="text-base font-bold" style={{ color: ACCENT }}>
                    NPR {calculateTotalCharges(selectedBooking).toLocaleString()}
                  </Text>
                </View>
              </View>

              {/* Checkout Button */}
              <TouchableOpacity onPress={handleCompleteCheckout}
                style={{
                  paddingVertical: 16, borderRadius: 16, alignItems: 'center', marginTop: 8,
                  backgroundColor: ACCENT,
                  shadowColor: ACCENT, shadowOffset: { width: 0, height: 4 }, shadowOpacity: 0.3, shadowRadius: 8, elevation: 4,
                }}
              >
                <Text className="text-base font-semibold text-white">Confirm Check-out</Text>
              </TouchableOpacity>
            </View>
          )}

          {step === 'complete' && selectedBooking && (
            <View style={{ alignItems: 'center', paddingVertical: 20 }}>
              <View style={{ width: 80, height: 80, borderRadius: 40, backgroundColor: '#10B98115', alignItems: 'center', justifyContent: 'center', marginBottom: 20 }}>
                <Text style={{ fontSize: 40 }}>✅</Text>
              </View>
              <Text className="text-xl font-bold text-foreground mb-2">Check-out Complete!</Text>
              <Text className="text-sm text-muted text-center mb-6">
                Thank you for staying at {selectedBooking.hotelName}.{'\n'}
                We hope to welcome you again soon!
              </Text>

              <View style={{ width: '100%', padding: 18, borderRadius: 18, backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border, marginBottom: 16 }}>
                <Text className="text-sm font-bold text-foreground mb-3">What's Next?</Text>
                <View className="gap-3">
                  <View className="flex-row items-center gap-3">
                    <Text style={{ fontSize: 20 }}>⭐</Text>
                    <Text className="text-sm text-foreground flex-1">Rate your stay — tap to leave a review</Text>
                  </View>
                  <View className="flex-row items-center gap-3">
                    <Text style={{ fontSize: 20 }}>📄</Text>
                    <Text className="text-sm text-foreground flex-1">Receipt sent to your email</Text>
                  </View>
                  <View className="flex-row items-center gap-3">
                    <Text style={{ fontSize: 20 }}>🎯</Text>
                    <Text className="text-sm text-foreground flex-1">+30 loyalty points earned</Text>
                  </View>
                </View>
              </View>

              <TouchableOpacity onPress={() => router.push('/(tabs)')}
                style={{
                  width: '100%', paddingVertical: 16, borderRadius: 16, alignItems: 'center',
                  backgroundColor: ACCENT, marginBottom: 12,
                }}
              >
                <Text className="text-base font-semibold text-white">Back to Home</Text>
              </TouchableOpacity>
            </View>
          )}
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
