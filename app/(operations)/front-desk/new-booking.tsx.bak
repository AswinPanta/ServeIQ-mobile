import React, { useState } from 'react';
import { View, Text, TextInput, TouchableOpacity, ScrollView, Alert } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';
import { useFrontDesk } from '@/lib/context/frontdesk-context';

const ACCENT = '#0D9488';

const ROOM_TYPES = [
  { id: 'standard' as const, name: 'Standard', price: '₹2,499/night', icon: '🛏️' },
  { id: 'deluxe' as const, name: 'Deluxe', price: '₹4,999/night', icon: '✨' },
  { id: 'suite' as const, name: 'Suite', price: '₹8,999/night', icon: '👑' },
];

export default function NewBookingScreen() {
  const colors = useColors();
  const { createBooking } = useFrontDesk();
  const [guestName, setGuestName] = useState('');
  const [email, setEmail] = useState('');
  const [phone, setPhone] = useState('');
  const [nationality, setNationality] = useState('');
  const [selectedRoom, setSelectedRoom] = useState<string>('');
  const [checkIn, setCheckIn] = useState('');
  const [checkOut, setCheckOut] = useState('');
  const [adults, setAdults] = useState(1);
  const [children, setChildren] = useState(0);
  const [specialRequests, setSpecialRequests] = useState('');

  const handleSubmit = () => {
    if (!guestName || !email || !phone || !selectedRoom || !checkIn || !checkOut) {
      Alert.alert('Incomplete', 'Please fill in all required fields');
      return;
    }
    createBooking({
      guestName,
      email,
      phone,
      nationality,
      roomType: selectedRoom as 'Standard' | 'Deluxe' | 'Suite',
      checkIn,
      checkOut,
      adults,
      children,
      specialRequests,
    });
    Alert.alert(
      'Booking Created',
      `Booking confirmed for ${guestName}\nRoom: ${selectedRoom}\nCheck-in: ${checkIn}\nCheck-out: ${checkOut}`,
      [{ text: 'OK', onPress: () => router.back() }]
    );
  };

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 32 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center gap-3">
            <TouchableOpacity onPress={() => router.back()}
              style={{ width: 40, height: 40, borderRadius: 12, backgroundColor: colors.surface, alignItems: 'center', justifyContent: 'center' }}
            >
              <Text className="text-lg">←</Text>
            </TouchableOpacity>
            <View>
              <Text className="text-2xl font-bold text-foreground">New Booking</Text>
              <Text className="text-sm text-muted">Walk-in or phone reservation</Text>
            </View>
          </View>
        </View>

        <View className="px-6 gap-5">
          <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
            <Text className="text-base font-bold text-foreground mb-4">Guest Details</Text>
            <View className="gap-4">
              {[
                { label: 'Full Name', value: guestName, set: setGuestName, placeholder: 'John Doe', required: true, keyboard: 'default' as const },
                { label: 'Email', value: email, set: setEmail, placeholder: 'john@email.com', required: true, keyboard: 'email-address' as const },
                { label: 'Phone', value: phone, set: setPhone, placeholder: '+1 234 567 890', required: true, keyboard: 'phone-pad' as const },
                { label: 'Nationality', value: nationality, set: setNationality, placeholder: 'e.g. Indian, American', required: false, keyboard: 'default' as const },
              ].map((field) => (
                <View key={field.label} className="gap-1.5">
                  <Text className="text-sm font-semibold text-foreground">
                    {field.label}{field.required ? <Text style={{ color: '#EF4444' }}> *</Text> : null}
                  </Text>
                  <TextInput placeholder={field.placeholder} placeholderTextColor={colors.muted}
                    value={field.value} onChangeText={field.set}
                    keyboardType={field.keyboard} autoCapitalize="none"
                    className="text-base text-foreground px-4 py-3 rounded-xl"
                    style={{ backgroundColor: colors.background, borderWidth: 1, borderColor: colors.border }}
                  />
                </View>
              ))}
            </View>
          </View>

          <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
            <Text className="text-base font-bold text-foreground mb-4">Room Type</Text>
            <View className="gap-3">
              {ROOM_TYPES.map((rt) => (
                <TouchableOpacity key={rt.id} onPress={() => setSelectedRoom(rt.id)}
                  style={{
                    flexDirection: 'row', alignItems: 'center', padding: 14, borderRadius: 14,
                    backgroundColor: selectedRoom === rt.id ? ACCENT + '10' : colors.background,
                    borderWidth: 1.5, borderColor: selectedRoom === rt.id ? ACCENT : colors.border,
                  }}
                >
                  <Text style={{ fontSize: 28, marginRight: 12 }}>{rt.icon}</Text>
                  <View className="flex-1">
                    <Text className="text-base font-bold text-foreground">{rt.name}</Text>
                    <Text className="text-sm text-muted">{rt.price}</Text>
                  </View>
                  {selectedRoom === rt.id && (
                    <View style={{ width: 22, height: 22, borderRadius: 11, backgroundColor: ACCENT, alignItems: 'center', justifyContent: 'center' }}>
                      <Text className="text-white text-xs">✓</Text>
                    </View>
                  )}
                </TouchableOpacity>
              ))}
            </View>
          </View>

          <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
            <Text className="text-base font-bold text-foreground mb-4">Stay Details</Text>
            <View className="flex-row gap-3">
              <View className="flex-1 gap-1.5">
                <Text className="text-sm font-semibold text-foreground">Check-in</Text>
                <TextInput placeholder="YYYY-MM-DD" placeholderTextColor={colors.muted}
                  value={checkIn} onChangeText={setCheckIn}
                  className="text-base text-foreground px-4 py-3 rounded-xl"
                  style={{ backgroundColor: colors.background, borderWidth: 1, borderColor: colors.border }}
                />
              </View>
              <View className="flex-1 gap-1.5">
                <Text className="text-sm font-semibold text-foreground">Check-out</Text>
                <TextInput placeholder="YYYY-MM-DD" placeholderTextColor={colors.muted}
                  value={checkOut} onChangeText={setCheckOut}
                  className="text-base text-foreground px-4 py-3 rounded-xl"
                  style={{ backgroundColor: colors.background, borderWidth: 1, borderColor: colors.border }}
                />
              </View>
            </View>
          </View>

          <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
            <Text className="text-base font-bold text-foreground mb-4">Guests</Text>
            <View className="gap-4">
              {[
                { label: 'Adults', val: adults, set: setAdults, min: 1, max: 10 },
                { label: 'Children', val: children, set: setChildren, min: 0, max: 6 },
              ].map((item) => (
                <View key={item.label} className="flex-row items-center justify-between">
                  <Text className="text-sm text-foreground">{item.label}</Text>
                  <View className="flex-row items-center gap-4">
                    <TouchableOpacity onPress={() => item.val > item.min && item.set(item.val - 1)}
                      style={{ width: 32, height: 32, borderRadius: 16, backgroundColor: ACCENT + '12', alignItems: 'center', justifyContent: 'center' }}
                    >
                      <Text className="text-base font-bold" style={{ color: ACCENT }}>−</Text>
                    </TouchableOpacity>
                    <Text className="text-base font-bold text-foreground w-6 text-center">{item.val}</Text>
                    <TouchableOpacity onPress={() => item.val < item.max && item.set(item.val + 1)}
                      style={{ width: 32, height: 32, borderRadius: 16, backgroundColor: ACCENT + '12', alignItems: 'center', justifyContent: 'center' }}
                    >
                      <Text className="text-base font-bold" style={{ color: ACCENT }}>+</Text>
                    </TouchableOpacity>
                  </View>
                </View>
              ))}
            </View>
          </View>

          <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
            <Text className="text-base font-bold text-foreground mb-3">Special Requests</Text>
            <TextInput placeholder="Any special requests..." placeholderTextColor={colors.muted}
              value={specialRequests} onChangeText={setSpecialRequests} multiline numberOfLines={3}
              className="text-base text-foreground px-4 py-3 rounded-xl"
              style={{ backgroundColor: colors.background, borderWidth: 1, borderColor: colors.border, minHeight: 80, textAlignVertical: 'top' }}
            />
          </View>

          <TouchableOpacity onPress={handleSubmit}
            style={{
              paddingVertical: 16, borderRadius: 16, alignItems: 'center',
              backgroundColor: ACCENT, marginTop: 4,
              shadowColor: ACCENT, shadowOffset: { width: 0, height: 4 }, shadowOpacity: 0.3, shadowRadius: 8, elevation: 4,
            }}
            activeOpacity={0.85}
          >
            <Text className="text-base font-semibold text-white">Create Booking</Text>
          </TouchableOpacity>
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
