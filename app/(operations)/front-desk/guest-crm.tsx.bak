/**
 * Guest CRM Screen (SRS 4.5: CR-001 through CR-008)
 * Staff-facing guest profile management with notes, loyalty tiers, and promotions
 */

import React, { useState } from 'react';
import { View, Text, TextInput, TouchableOpacity, ScrollView, Alert, Modal } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';
import { useCRM, LOYALTY_TIERS } from '@/lib/context/crm-context';

const ACCENT = '#0D9488';

export default function GuestCRMScreen() {
  const colors = useColors();
  const { crmProfiles, getProfile, addNote, earnPoints, getActivePromotions, getPromotionsForGuest, getTierBenefits } = useCRM();
  const [search, setSearch] = useState('');
  const [selectedGuestId, setSelectedGuestId] = useState<string | null>(null);
  const [noteText, setNoteText] = useState('');
  const [showNotes, setShowNotes] = useState(false);

  const profiles = Array.from(crmProfiles.values());
  const filtered = search
    ? profiles.filter(p =>
        (p.name || '').toLowerCase().includes(search.toLowerCase()) ||
        p.email.toLowerCase().includes(search.toLowerCase()) ||
        (p.phone || '').includes(search)
      )
    : profiles;

  const selectedProfile = selectedGuestId ? getProfile(selectedGuestId) : null;
  const selectedPromotions = selectedGuestId ? getPromotionsForGuest(selectedGuestId) : [];
  const activePromotions = getActivePromotions();

  const handleAddNote = () => {
    if (!selectedGuestId || !noteText.trim()) return;
    addNote(selectedGuestId, noteText.trim());
    setNoteText('');
    Alert.alert('Note Added', 'Guest note has been saved.');
  };

  const handleAwardPoints = () => {
    if (!selectedGuestId) return;
    Alert.alert('Award Points', 'Enter points to award:', [
      { text: 'Cancel', style: 'cancel' },
      {
        text: '100 pts',
        onPress: () => { earnPoints(selectedGuestId, 100); Alert.alert('Done', '100 points awarded'); },
      },
      {
        text: '500 pts',
        onPress: () => { earnPoints(selectedGuestId, 500); Alert.alert('Done', '500 points awarded'); },
      },
    ]);
  };

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 40 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center gap-3">
            <TouchableOpacity onPress={() => router.back()}
              style={{ width: 40, height: 40, borderRadius: 12, backgroundColor: colors.surface, alignItems: 'center', justifyContent: 'center' }}
            >
              <Text className="text-lg">←</Text>
            </TouchableOpacity>
            <View>
              <Text className="text-2xl font-bold text-foreground">Guest CRM</Text>
              <Text className="text-sm text-muted">{profiles.length} registered guests</Text>
            </View>
          </View>
        </View>

        <View className="px-6">
          <View style={{ padding: 16, borderRadius: 18, backgroundColor: colors.surface, marginBottom: 16 }}>
            <TextInput placeholder="Search guests by name, email, or phone..."
              placeholderTextColor={colors.muted} value={search} onChangeText={setSearch}
              className="text-base text-foreground px-4 py-3 rounded-xl"
              style={{ backgroundColor: colors.background, borderWidth: 1, borderColor: colors.border }}
            />
          </View>

          {selectedProfile ? (
            <View style={{ padding: 20, borderRadius: 20, backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border }}>
              {/* Guest Header */}
              <View className="flex-row items-center gap-4 mb-5">
                <View style={{ width: 56, height: 56, borderRadius: 28, backgroundColor: ACCENT + '20', alignItems: 'center', justifyContent: 'center' }}>
                  <Text style={{ fontSize: 22, fontWeight: '700', color: ACCENT }}>{(selectedProfile.name || '?').charAt(0)}</Text>
                </View>
                <View className="flex-1">
                  <Text className="text-lg font-bold text-foreground">{selectedProfile.name || 'Unknown'}</Text>
                  <Text className="text-sm text-muted">{selectedProfile.email}</Text>
                  <Text className="text-sm text-muted">{selectedProfile.phone}</Text>
                </View>
                <TouchableOpacity onPress={() => setSelectedGuestId(null)}
                  style={{ paddingHorizontal: 12, paddingVertical: 6, borderRadius: 8, backgroundColor: colors.border }}>
                  <Text className="text-xs font-semibold">Close</Text>
                </TouchableOpacity>
              </View>

              {/* Loyalty Card */}
              <View style={{ padding: 16, borderRadius: 16, backgroundColor: '#1A3C5E', marginBottom: 16 }}>
                <View className="flex-row items-center justify-between mb-2">
                  <Text className="text-white font-bold">Loyalty Status</Text>
                  <View style={{ paddingHorizontal: 10, paddingVertical: 3, borderRadius: 8, backgroundColor: 'rgba(255,255,255,0.2)' }}>
                    <Text className="text-white text-xs font-bold">{selectedProfile.computedTier}</Text>
                  </View>
                </View>
                <Text style={{ fontSize: 28, fontWeight: '700', color: '#FFD700' }}>
                  {selectedProfile.loyalty_points?.toLocaleString() || '0'}
                </Text>
                <Text className="text-white/70 text-xs">Points · {selectedProfile.totalStays} stays · NPR {selectedProfile.totalSpent.toLocaleString()} spent</Text>
                <View className="flex-row gap-2 mt-3">
                  <TouchableOpacity onPress={handleAwardPoints}
                    style={{ flex: 1, paddingVertical: 8, borderRadius: 8, backgroundColor: 'rgba(255,255,255,0.15)', alignItems: 'center' }}>
                    <Text className="text-white text-xs font-semibold">Award Points</Text>
                  </TouchableOpacity>
                  <TouchableOpacity onPress={() => setShowNotes(!showNotes)}
                    style={{ flex: 1, paddingVertical: 8, borderRadius: 8, backgroundColor: 'rgba(255,255,255,0.15)', alignItems: 'center' }}>
                    <Text className="text-white text-xs font-semibold">{showNotes ? 'Hide Notes' : 'Notes'}</Text>
                  </TouchableOpacity>
                </View>
              </View>

              {/* Tier Benefits */}
              <View style={{ padding: 14, borderRadius: 14, backgroundColor: colors.background, marginBottom: 16 }}>
                <Text className="text-sm font-bold text-foreground mb-2">{selectedProfile.computedTier} Benefits</Text>
                {getTierBenefits(selectedProfile.computedTier).map((benefit, i) => (
                  <View key={i} className="flex-row items-center gap-2 mb-1.5">
                    <Text style={{ color: ACCENT }}>✓</Text>
                    <Text className="text-xs text-muted">{benefit}</Text>
                  </View>
                ))}
              </View>

              {/* Promotion Offers */}
              {selectedPromotions.length > 0 && (
                <View style={{ marginBottom: 16 }}>
                  <Text className="text-sm font-bold text-foreground mb-3">Available Promotions</Text>
                  {selectedPromotions.map(promo => (
                    <View key={promo.id} style={{ padding: 12, borderRadius: 12, backgroundColor: '#F59E0B10', borderWidth: 1, borderColor: '#F59E0B20', marginBottom: 8 }}>
                      <Text className="text-sm font-semibold text-foreground">{promo.title}</Text>
                      <Text className="text-xs text-muted mt-1">{promo.description}</Text>
                      <View className="flex-row items-center gap-2 mt-2">
                        <View style={{ paddingHorizontal: 8, paddingVertical: 2, borderRadius: 6, backgroundColor: '#F59E0B20' }}>
                          <Text className="text-xs font-bold" style={{ color: '#F59E0B' }}>{promo.discountCode}</Text>
                        </View>
                        {promo.discountPercentage > 0 && (
                          <Text className="text-xs font-bold" style={{ color: '#10B981' }}>{promo.discountPercentage}% OFF</Text>
                        )}
                      </View>
                    </View>
                  ))}
                </View>
              )}

              {/* Notes Section */}
              {showNotes && (
                <View style={{ marginBottom: 16 }}>
                  <Text className="text-sm font-bold text-foreground mb-3">Staff Notes</Text>
                  {selectedProfile.notes.length === 0 ? (
                    <Text className="text-xs text-muted italic mb-3">No notes for this guest yet.</Text>
                  ) : (
                    selectedProfile.notes.map(note => (
                      <View key={note.id} style={{ padding: 10, borderRadius: 10, backgroundColor: colors.background, marginBottom: 6 }}>
                        <Text className="text-xs text-muted">{note.text}</Text>
                        <Text className="text-[11px] text-muted mt-1">{new Date(note.createdAt).toLocaleDateString()} by {note.author}</Text>
                      </View>
                    ))
                  )}
                  <View className="flex-row gap-2">
                    <TextInput value={noteText} onChangeText={setNoteText} placeholder="Add a note..."
                      placeholderTextColor={colors.muted}
                      className="flex-1 text-sm text-foreground px-3 py-2 rounded-lg"
                      style={{ backgroundColor: colors.background, borderWidth: 1, borderColor: colors.border }}
                    />
                    <TouchableOpacity onPress={handleAddNote}
                      style={{ paddingHorizontal: 16, paddingVertical: 8, borderRadius: 10, backgroundColor: ACCENT, justifyContent: 'center' }}>
                      <Text className="text-sm font-semibold text-white">Add</Text>
                    </TouchableOpacity>
                  </View>
                </View>
              )}
            </View>
          ) : (
            <>
              {/* Active Promotions Banner */}
              {activePromotions.length > 0 && (
                <View style={{ padding: 14, borderRadius: 16, backgroundColor: '#F59E0B10', borderWidth: 1, borderColor: '#F59E0B20', marginBottom: 16 }}>
                  <Text className="text-sm font-bold text-foreground mb-2">🎉 Active Promotions</Text>
                  {activePromotions.map(p => (
                    <View key={p.id} className="flex-row items-center justify-between mb-1.5">
                      <Text className="text-xs text-muted flex-1">{p.title}</Text>
                      <View style={{ paddingHorizontal: 6, paddingVertical: 1, borderRadius: 4, backgroundColor: '#F59E0B20' }}>
                        <Text className="text-[10px] font-bold" style={{ color: '#F59E0B' }}>{p.discountCode}</Text>
                      </View>
                    </View>
                  ))}
                </View>
              )}

              {/* Guest List */}
              {filtered.length === 0 ? (
                <View style={{ padding: 40, alignItems: 'center' }}>
                  <Text className="text-lg mb-2">👤</Text>
                  <Text className="text-sm text-muted text-center">
                    {search ? 'No guests found matching your search' : 'No guest profiles yet. Guest profiles are created automatically on first booking.'}
                  </Text>
                </View>
              ) : (
                filtered.map(profile => {
                  const tierConfig = LOYALTY_TIERS.find(t => t.tier === profile.computedTier);
                  return (
                    <TouchableOpacity key={profile.id} onPress={() => setSelectedGuestId(profile.id)}
                      style={{ flexDirection: 'row', alignItems: 'center', padding: 14, borderRadius: 16, backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border, marginBottom: 8 }}
                    >
                      <View style={{ width: 44, height: 44, borderRadius: 22, backgroundColor: (tierConfig?.color || '#CD7F32') + '20', alignItems: 'center', justifyContent: 'center', marginRight: 14 }}>
                        <Text style={{ fontSize: 18, fontWeight: '700', color: tierConfig?.color || '#CD7F32' }}>{(profile.name || '?').charAt(0)}</Text>
                      </View>
                      <View className="flex-1">
                        <Text className="text-sm font-bold text-foreground">{profile.name || 'Unknown'}</Text>
                        <Text className="text-xs text-muted">{profile.email}</Text>
                        <View className="flex-row items-center gap-2 mt-1">
                          <View style={{ paddingHorizontal: 6, paddingVertical: 1, borderRadius: 4, backgroundColor: (tierConfig?.color || '#CD7F32') + '20' }}>
                            <Text style={{ fontSize: 9, fontWeight: '700', color: tierConfig?.color || '#CD7F32' }}>{profile.computedTier}</Text>
                          </View>
                          <Text className="text-xs text-muted">{profile.loyalty_points?.toLocaleString() || 0} pts</Text>
                          <Text className="text-xs text-muted">{profile.totalStays} stays</Text>
                        </View>
                      </View>
                      <Text className="text-lg text-muted">›</Text>
                    </TouchableOpacity>
                  );
                })
              )}
            </>
          )}
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
