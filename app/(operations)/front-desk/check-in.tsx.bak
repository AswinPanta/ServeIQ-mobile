import React, { useState } from 'react';
import { View, Text, TextInput, TouchableOpacity, ScrollView, Alert } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';
import { useFrontDesk } from '@/lib/context/frontdesk-context';

const ACCENT = '#0D9488';

export default function CheckInScreen() {
  const colors = useColors();
  const { rooms, arrivingGuests, checkIn } = useFrontDesk();
  const [search, setSearch] = useState('');
  const [selectedGuest, setSelectedGuest] = useState<typeof arrivingGuests[0] | null>(null);
  const [selectedRoom, setSelectedRoom] = useState('');
  const [idVerified, setIdVerified] = useState(false);

  const availableRooms = rooms.filter(r => r.status === 'Available');

  // Suggested rooms match the guest's booked room type (CI-003)
  const suggestedRooms = selectedGuest
    ? availableRooms.filter(r => {
        // Match by room prefix convention: Standard rooms 1xx, Deluxe 3xx, Suite 4xx
        if (selectedGuest.roomType === 'Standard') return r.number.startsWith('1');
        if (selectedGuest.roomType === 'Deluxe') return r.number.startsWith('3');
        if (selectedGuest.roomType === 'Suite') return r.number.startsWith('4');
        return false;
      })
    : [];
  const otherRooms = availableRooms.filter(r => !suggestedRooms.includes(r));

  const filteredGuests = arrivingGuests.filter(g =>
    g.guestName.toLowerCase().includes(search.toLowerCase()) ||
    g.email.toLowerCase().includes(search.toLowerCase())
  );

  const handleConfirm = () => {
    if (!selectedGuest || !selectedRoom) {
      Alert.alert('Incomplete', 'Please select a guest and assign a room');
      return;
    }
    checkIn(selectedGuest, selectedRoom);
    Alert.alert(
      'Check-in Complete',
      `${selectedGuest.guestName} checked into Room ${selectedRoom}`,
      [{ text: 'OK', onPress: () => router.back() }]
    );
  };

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 32 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center gap-3">
            <TouchableOpacity onPress={() => router.back()}
              style={{ width: 40, height: 40, borderRadius: 12, backgroundColor: colors.surface, alignItems: 'center', justifyContent: 'center' }}
            >
              <Text className="text-lg">←</Text>
            </TouchableOpacity>
            <View>
              <Text className="text-2xl font-bold text-foreground">Check-in</Text>
              <Text className="text-sm text-muted">Process guest arrival</Text>
            </View>
          </View>
        </View>

        <View className="px-6 gap-5">
          <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
            <Text className="text-base font-bold text-foreground mb-3">Search Guest</Text>
            <TextInput placeholder="Search by name or email..." placeholderTextColor={colors.muted}
              value={search} onChangeText={setSearch}
              className="text-base text-foreground px-4 py-3 rounded-xl"
              style={{ backgroundColor: colors.background, borderWidth: 1, borderColor: colors.border }}
            />
            {search.length > 0 && filteredGuests.map((g) => (
              <TouchableOpacity key={g.id} onPress={() => { setSelectedGuest(g); setSearch(''); }}
                style={{
                  flexDirection: 'row', alignItems: 'center', padding: 12, marginTop: 8, borderRadius: 12,
                  backgroundColor: selectedGuest?.id === g.id ? ACCENT + '10' : colors.background,
                  borderWidth: 1, borderColor: selectedGuest?.id === g.id ? ACCENT : colors.border,
                }}
              >
                <View style={{ width: 40, height: 40, borderRadius: 12, backgroundColor: ACCENT + '12', alignItems: 'center', justifyContent: 'center', marginRight: 12 }}>
                  <Text className="text-base font-bold" style={{ color: ACCENT }}>{g.guestName.charAt(0)}</Text>
                </View>
                <View className="flex-1">
                  <Text className="text-sm font-bold text-foreground">{g.guestName}</Text>
                  <Text className="text-xs text-muted">{g.email} · {g.bookingRef}</Text>
                </View>
              </TouchableOpacity>
            ))}
            {search.length > 0 && filteredGuests.length === 0 && (
              <Text className="text-sm text-muted text-center py-4">No guests found</Text>
            )}
          </View>

          {selectedGuest && (
            <>
              <View style={{ padding: 18, borderRadius: 18, backgroundColor: ACCENT + '08', borderWidth: 1, borderColor: ACCENT + '20' }}>
                <Text className="text-sm font-semibold text-foreground mb-3">Selected Guest</Text>
                <View className="gap-2">
                  <View className="flex-row justify-between">
                    <Text className="text-sm text-muted">Name</Text>
                    <Text className="text-sm font-semibold text-foreground">{selectedGuest.guestName}</Text>
                  </View>
                  <View className="flex-row justify-between">
                    <Text className="text-sm text-muted">Booking Ref</Text>
                    <Text className="text-sm font-semibold" style={{ color: ACCENT }}>{selectedGuest.bookingRef}</Text>
                  </View>
                  <View className="flex-row justify-between">
                    <Text className="text-sm text-muted">Room Type</Text>
                    <Text className="text-sm font-semibold text-foreground">{selectedGuest.roomType}</Text>
                  </View>
                  <View className="flex-row justify-between">
                    <Text className="text-sm text-muted">Dates</Text>
                    <Text className="text-sm font-semibold text-foreground">{selectedGuest.checkIn} → {selectedGuest.checkOut}</Text>
                  </View>
                </View>
              </View>

              <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
                <Text className="text-base font-bold text-foreground mb-4">Assign Room</Text>
                {availableRooms.length === 0 ? (
                  <Text className="text-sm text-muted">No available rooms</Text>
                ) : (
                  <>
                    {/* Auto-suggested rooms matching booked room type (CI-003) */}
                    {suggestedRooms.length > 0 && (
                      <>
                        <Text className="text-xs font-semibold text-success mb-2">✨ Suggested for {selectedGuest?.roomType}</Text>
                        <View className="flex-row flex-wrap gap-2 mb-3">
                          {suggestedRooms.map((room) => (
                            <TouchableOpacity key={room.number} onPress={() => setSelectedRoom(room.number)}
                              style={{
                                paddingHorizontal: 16, paddingVertical: 10, borderRadius: 12,
                                backgroundColor: selectedRoom === room.number ? ACCENT : '#10B981' + '15',
                                borderWidth: 1.5, borderColor: selectedRoom === room.number ? ACCENT : '#10B981' + '30',
                              }}
                            >
                              <Text className="text-sm font-bold" style={{ color: selectedRoom === room.number ? '#fff' : '#10B981' }}>{room.number}</Text>
                            </TouchableOpacity>
                          ))}
                        </View>
                      </>
                    )}
                    {/* Other available rooms */}
                    {otherRooms.length > 0 && (
                      <>
                        {suggestedRooms.length > 0 && <Text className="text-xs text-muted mb-2">Other available rooms</Text>}
                        <View className="flex-row flex-wrap gap-2">
                          {otherRooms.map((room) => (
                            <TouchableOpacity key={room.number} onPress={() => setSelectedRoom(room.number)}
                              style={{
                                paddingHorizontal: 16, paddingVertical: 10, borderRadius: 12,
                                backgroundColor: selectedRoom === room.number ? ACCENT : ACCENT + '10',
                                borderWidth: 1.5, borderColor: selectedRoom === room.number ? ACCENT : colors.border,
                              }}
                            >
                              <Text className="text-sm font-bold" style={{ color: selectedRoom === room.number ? '#fff' : ACCENT }}>{room.number}</Text>
                            </TouchableOpacity>
                          ))}
                        </View>
                      </>
                    )}
                  </>
                )}
              </View>

              <TouchableOpacity onPress={() => setIdVerified(!idVerified)}
                style={{
                  flexDirection: 'row', alignItems: 'center', padding: 14, borderRadius: 14,
                  backgroundColor: idVerified ? '#10B981' + '10' : colors.surface,
                  borderWidth: 1.5, borderColor: idVerified ? '#10B981' : colors.border,
                }}
              >
                <View style={{ width: 24, height: 24, borderRadius: 6, borderWidth: 2, borderColor: idVerified ? '#10B981' : colors.border, alignItems: 'center', justifyContent: 'center', marginRight: 12 }}>
                  {idVerified && <Text style={{ color: '#10B981', fontSize: 16 }}>✓</Text>}
                </View>
                <View className="flex-1">
                  <Text className="text-sm font-bold text-foreground">ID Verified</Text>
                  <Text className="text-xs text-muted">Guest identification confirmed</Text>
                </View>
              </TouchableOpacity>

              <TouchableOpacity onPress={handleConfirm}
                style={{
                  paddingVertical: 16, borderRadius: 16, alignItems: 'center',
                  backgroundColor: ACCENT, marginTop: 4,
                  shadowColor: ACCENT, shadowOffset: { width: 0, height: 4 }, shadowOpacity: 0.3, shadowRadius: 8, elevation: 4,
                }}
                activeOpacity={0.85}
              >
                <Text className="text-base font-semibold text-white">Confirm Check-in</Text>
              </TouchableOpacity>
            </>
          )}
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
