import React, { useState } from 'react';
import { View, Text, TextInput, TouchableOpacity, ScrollView, Alert } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';
import { useFrontDesk } from '@/lib/context/frontdesk-context';

const ACCENT = '#0D9488';

const PAYMENT_METHODS = [
  { id: 'card', label: 'Card', icon: '💳' },
  { id: 'cash', label: 'Cash', icon: '💵' },
  { id: 'upi', label: 'UPI', icon: '📱' },
  { id: 'wallet', label: 'Wallet', icon: '👛' },
];

function FolioBreakdown({ guest }: { guest: { name: string; room: string; roomType: string } }) {
  const roomPrices: Record<string, number> = { Standard: 2499, Deluxe: 4999, Suite: 8999 };
  const roomCharge = roomPrices[guest.roomType] || 4999;
  const mealsCharge = 2150;
  const extrasCharge = 800;
  const tax = Math.round((roomCharge + mealsCharge + extrasCharge) * 0.12);
  const total = roomCharge + mealsCharge + extrasCharge + tax;

  const items = [
    { label: 'Room Charges', value: `₹${roomCharge.toLocaleString()}` },
    { label: 'Meals & Beverages', value: `₹${mealsCharge.toLocaleString()}` },
    { label: 'Extras (Mini Bar, Spa)', value: `₹${extrasCharge.toLocaleString()}` },
    { label: 'Tax (12%)', value: `₹${tax.toLocaleString()}` },
  ];

  return (
    <View className="gap-3">
      {items.map((item, i) => (
        <View key={i} className="flex-row justify-between">
          <Text className="text-sm text-muted">{item.label}</Text>
          <Text className="text-sm font-semibold text-foreground">{item.value}</Text>
        </View>
      ))}
      <View className="border-t border-border pt-3 flex-row justify-between">
        <Text className="text-base font-bold text-foreground">Grand Total</Text>
        <Text className="text-base font-bold" style={{ color: ACCENT }}>₹{total.toLocaleString()}</Text>
      </View>
    </View>
  );
}

export default function CheckOutScreen() {
  const colors = useColors();
  const { checkedInGuests, checkOut } = useFrontDesk();
  const [search, setSearch] = useState('');
  const [selectedGuest, setSelectedGuest] = useState<typeof checkedInGuests[0] | null>(null);
  const [paymentMethod, setPaymentMethod] = useState('');

  const filteredGuests = checkedInGuests.filter(g =>
    g.guestName.toLowerCase().includes(search.toLowerCase()) ||
    (g.roomNumber && g.roomNumber.includes(search))
  );

  const handleProcessCheckout = () => {
    if (!selectedGuest || !paymentMethod) {
      Alert.alert('Incomplete', 'Please select a guest and payment method');
      return;
    }
    // CI-007: checkOut now auto-notifies housekeeping via frontdesk context
    checkOut(selectedGuest.id, selectedGuest.roomNumber || '');
    Alert.alert(
      'Check-out Complete',
      `${selectedGuest.guestName} checked out successfully\nPayment: ${paymentMethod.toUpperCase()}\n\n🧹 Housekeeping notified for Room ${selectedGuest.roomNumber}`,
      [{ text: 'OK', onPress: () => router.back() }]
    );
  };

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 32 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center gap-3">
            <TouchableOpacity onPress={() => router.back()}
              style={{ width: 40, height: 40, borderRadius: 12, backgroundColor: colors.surface, alignItems: 'center', justifyContent: 'center' }}
            >
              <Text className="text-lg">←</Text>
            </TouchableOpacity>
            <View>
              <Text className="text-2xl font-bold text-foreground">Check-out</Text>
              <Text className="text-sm text-muted">Process guest departure</Text>
            </View>
          </View>
        </View>

        <View className="px-6 gap-5">
          <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
            <Text className="text-base font-bold text-foreground mb-3">Search Checked-in Guest</Text>
            <TextInput placeholder="Search by name or room..." placeholderTextColor={colors.muted}
              value={search} onChangeText={setSearch}
              className="text-base text-foreground px-4 py-3 rounded-xl"
              style={{ backgroundColor: colors.background, borderWidth: 1, borderColor: colors.border }}
            />
            {search.length > 0 && filteredGuests.map((g) => (
              <TouchableOpacity key={g.id} onPress={() => { setSelectedGuest(g); setSearch(''); }}
                style={{
                  flexDirection: 'row', alignItems: 'center', padding: 12, marginTop: 8, borderRadius: 12,
                  backgroundColor: selectedGuest?.id === g.id ? ACCENT + '10' : colors.background,
                  borderWidth: 1, borderColor: selectedGuest?.id === g.id ? ACCENT : colors.border,
                }}
              >
                <View style={{ width: 40, height: 40, borderRadius: 12, backgroundColor: '#3B82F612', alignItems: 'center', justifyContent: 'center', marginRight: 12 }}>
                  <Text className="text-base font-bold" style={{ color: '#3B82F6' }}>{g.roomNumber || '—'}</Text>
                </View>
                <View className="flex-1">
                  <Text className="text-sm font-bold text-foreground">{g.guestName}</Text>
                  <Text className="text-xs text-muted">{g.bookingRef} · {g.checkIn} → {g.checkOut}</Text>
                </View>
              </TouchableOpacity>
            ))}
            {search.length > 0 && filteredGuests.length === 0 && (
              <Text className="text-sm text-muted text-center py-4">No checked-in guests found</Text>
            )}
          </View>

          {selectedGuest && (
            <>
              <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
                <Text className="text-base font-bold text-foreground mb-3">Guest Folio</Text>
                <FolioBreakdown guest={{ name: selectedGuest.guestName, room: selectedGuest.roomNumber || '', roomType: selectedGuest.roomType }} />
              </View>

              <View style={{ padding: 18, borderRadius: 18, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2 }}>
                <Text className="text-base font-bold text-foreground mb-4">Payment Method</Text>
                <View className="flex-row flex-wrap gap-3">
                  {PAYMENT_METHODS.map((pm) => (
                    <TouchableOpacity key={pm.id} onPress={() => setPaymentMethod(pm.id)}
                      style={{
                        flex: 1, padding: 14, borderRadius: 14, alignItems: 'center',
                        backgroundColor: paymentMethod === pm.id ? ACCENT + '10' : colors.background,
                        borderWidth: 1.5, borderColor: paymentMethod === pm.id ? ACCENT : colors.border,
                        minWidth: '45%',
                      }}
                    >
                      <Text style={{ fontSize: 24, marginBottom: 4 }}>{pm.icon}</Text>
                      <Text className="text-sm font-bold" style={{ color: paymentMethod === pm.id ? ACCENT : colors.text }}>{pm.label}</Text>
                    </TouchableOpacity>
                  ))}
                </View>
              </View>

              <TouchableOpacity onPress={handleProcessCheckout}
                style={{
                  paddingVertical: 16, borderRadius: 16, alignItems: 'center',
                  backgroundColor: ACCENT, marginTop: 4,
                  shadowColor: ACCENT, shadowOffset: { width: 0, height: 4 }, shadowOpacity: 0.3, shadowRadius: 8, elevation: 4,
                }}
                activeOpacity={0.85}
              >
                <Text className="text-base font-semibold text-white">Process Check-out</Text>
              </TouchableOpacity>
            </>
          )}
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
