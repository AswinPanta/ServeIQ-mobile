import React, { useState } from 'react';
import { View, Text, TouchableOpacity, ScrollView } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';
import { useHousekeeping, STATUS_FLOW_COLORS } from '@/lib/context/housekeeping-context';

const ACCENT = '#0D9488';

const FILTERS = ['All', 'Dirty', 'In Progress', 'Inspected'] as const;

const PRIORITY_COLORS: Record<string, string> = {
  High: '#EF4444',
  Normal: '#F59E0B',
  Low: '#10B981',
};

export default function HousekeepingScreen() {
  const colors = useColors();
  const { tasks, summaryStats } = useHousekeeping();
  const [activeFilter, setActiveFilter] = useState<string>('All');

  const filteredTasks = activeFilter === 'All' ? tasks : tasks.filter(t => t.status === activeFilter);

  const HK_SUMMARY = [
    { label: 'Dirty', value: summaryStats.dirty, color: '#F59E0B', icon: '⚠️' },
    { label: 'In Progress', value: summaryStats.inProgress, color: '#3B82F6', icon: '🔄' },
    { label: 'Inspected', value: summaryStats.inspected, color: '#8B5CF6', icon: '✅' },
    { label: 'Cleaners', value: summaryStats.cleaners, color: '#10B981', icon: '🧹' },
  ];

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 32 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center gap-3">
            <TouchableOpacity onPress={() => router.back()}
              style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: colors.surface, alignItems: 'center', justifyContent: 'center' }}
            >
              <Text className="text-lg">←</Text>
            </TouchableOpacity>
            <Text className="text-2xl font-bold text-foreground">Housekeeping</Text>
          </View>
        </View>

        <View className="px-6 mb-5">
          <View className="flex-row gap-2">
            {HK_SUMMARY.map((stat) => (
              <View key={stat.label}
                style={{
                  flex: 1, paddingVertical: 12, paddingHorizontal: 4, borderRadius: 12,
                  backgroundColor: stat.color + '0C',
                  alignItems: 'center',
                }}
              >
                <Text style={{ fontSize: 16, marginBottom: 4 }}>{stat.icon}</Text>
                <Text className="text-base font-bold" style={{ color: stat.color }}>{stat.value}</Text>
                <Text className="text-xs text-muted">{stat.label}</Text>
              </View>
            ))}
          </View>
        </View>

        <View className="px-6 mb-6">
          <ScrollView horizontal showsHorizontalScrollIndicator={false} className="gap-2">
            <View className="flex-row gap-2">
              {FILTERS.map((f) => (
                <TouchableOpacity key={f} onPress={() => setActiveFilter(f)}
                  style={{
                    paddingHorizontal: 16, paddingVertical: 8, borderRadius: 20,
                    backgroundColor: activeFilter === f ? ACCENT : colors.surface,
                    borderWidth: 1, borderColor: activeFilter === f ? ACCENT : colors.border,
                  }}
                >
                  <Text className="text-sm font-semibold" style={{ color: activeFilter === f ? '#fff' : colors.text }}>{f}</Text>
                </TouchableOpacity>
              ))}
            </View>
          </ScrollView>
        </View>

        <View className="px-6 gap-3">
          <View className="flex-row items-center justify-between mb-1">
            <Text className="text-sm text-muted">{filteredTasks.length} tasks</Text>
          </View>
          {filteredTasks.map((task) => {
            const statusColor = STATUS_FLOW_COLORS[task.status] || colors.muted;
            const priorityColor = PRIORITY_COLORS[task.priority];
            return (
              <TouchableOpacity key={task.id} onPress={() => router.push(`/(operations)/housekeeping/${task.room}` as any)}
                style={{
                  padding: 16, borderRadius: 16, backgroundColor: colors.surface,
                  shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 4, elevation: 2,
                }}
                activeOpacity={0.8}
              >
                <View className="flex-row items-center justify-between mb-2">
                  <View className="flex-row items-center gap-3">
                    <View style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: ACCENT + '12', alignItems: 'center', justifyContent: 'center' }}>
                      <Text className="text-lg font-bold" style={{ color: ACCENT }}>{task.room}</Text>
                    </View>
                    <View>
                      <Text className="text-base font-bold text-foreground">Room {task.room}</Text>
                      <Text className="text-xs text-muted">Floor {task.floor}</Text>
                    </View>
                  </View>
                  <View style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                    <View style={{ paddingHorizontal: 8, paddingVertical: 4, borderRadius: 8, backgroundColor: statusColor + '15' }}>
                      <Text className="text-xs font-bold" style={{ color: statusColor }}>{task.status}</Text>
                    </View>
                    <View style={{ width: 8, height: 8, borderRadius: 4, backgroundColor: priorityColor }} />
                  </View>
                </View>
                <View className="flex-row items-center justify-between pt-2 border-t border-border">
                  <Text className="text-xs text-muted">🧹 {task.cleaner}</Text>
                  <Text className="text-xs text-muted">Last: {task.lastCleaned}</Text>
                </View>
              </TouchableOpacity>
            );
          })}
          {filteredTasks.length === 0 && (
            <Text className="text-sm text-muted text-center py-10">No tasks found for this filter</Text>
          )}
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
