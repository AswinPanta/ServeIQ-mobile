import React, { useState, useEffect } from 'react';
import { View, Text, TouchableOpacity, ScrollView } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';
import { useRestaurant } from '@/lib/context/restaurant-context';

const ACCENT = '#0D9488';

const STATUS_COLORS: Record<string, string> = {
  New: '#EF4444',
  Preparing: '#F59E0B',
  Ready: '#10B981',
};

const STATUS_BG: Record<string, string> = {
  New: '#EF444412',
  Preparing: '#F59E0B12',
  Ready: '#10B98112',
};

const NEXT_STATUS: Record<string, string> = {
  New: 'Preparing',
  Preparing: 'Ready',
  Ready: 'Ready',
};

export default function KDSScreen() {
  const colors = useColors();
  const { tickets, advanceTicketStatus } = useRestaurant();
  const [newOrderAlert, setNewOrderAlert] = useState(false);

  useEffect(() => {
    const newCount = tickets.filter(t => t.status === 'New').length;
    setNewOrderAlert(newCount > 0);
  }, [tickets]);

  const newCount = tickets.filter(t => t.status === 'New').length;

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 32 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center justify-between">
            <View className="flex-row items-center gap-3">
              <TouchableOpacity onPress={() => router.back()}
                style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: colors.surface, alignItems: 'center', justifyContent: 'center' }}
              >
                <Text className="text-lg">←</Text>
              </TouchableOpacity>
              <Text className="text-2xl font-bold text-foreground">KDS</Text>
            </View>
            <View className="flex-row items-center gap-2">
              <View style={{ width: 12, height: 12, borderRadius: 4, backgroundColor: newCount > 0 ? '#EF4444' : '#10B981' }} />
              <Text className="text-sm text-muted">{newCount > 0 ? `${newCount} new` : 'Live'}</Text>
              {newOrderAlert && (
                <View style={{ paddingHorizontal: 8, paddingVertical: 4, borderRadius: 8, backgroundColor: '#EF4444' }}>
                  <Text className="text-xs font-bold text-white">{newCount}</Text>
                </View>
              )}
            </View>
          </View>
        </View>

        <View className="px-6 gap-4">
          {tickets.length === 0 && (
            <View style={{ padding: 40, borderRadius: 20, backgroundColor: colors.surface, alignItems: 'center' }}>
              <Text style={{ fontSize: 48, marginBottom: 12 }}>✅</Text>
              <Text className="text-lg font-bold text-foreground">All Caught Up!</Text>
              <Text className="text-sm text-muted mt-1">No pending orders</Text>
            </View>
          )}

          {tickets.map((ticket) => {
            const color = STATUS_COLORS[ticket.status];
            const bg = STATUS_BG[ticket.status];
            return (
              <View key={ticket.id}
                style={{
                  padding: 16, borderRadius: 20, backgroundColor: colors.surface,
                  borderLeftWidth: 4, borderLeftColor: color,
                  shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.06, shadowRadius: 6, elevation: 3,
                }}
              >
                <View className="flex-row items-center justify-between mb-3">
                  <View className="flex-row items-center gap-3">
                    <View style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: bg, alignItems: 'center', justifyContent: 'center' }}>
                      <Text className="text-lg font-bold" style={{ color }}>{ticket.tableNumber}</Text>
                    </View>
                    <View>
                      <Text className="text-base font-bold text-foreground">{ticket.orderNumber}</Text>
                      <Text className="text-xs text-muted">Table {ticket.tableNumber} · {ticket.timeSinceOrdered} ago</Text>
                    </View>
                  </View>
                  <View style={{ paddingHorizontal: 12, paddingVertical: 4, borderRadius: 8, backgroundColor: bg }}>
                    <Text className="text-xs font-bold" style={{ color }}>{ticket.status}</Text>
                  </View>
                </View>

                <View className="gap-1 mb-3">
                  {ticket.items.map((item, i) => (
                    <View key={i} className="flex-row items-center gap-2">
                      <Text style={{ fontSize: 12, color }}>●</Text>
                      <Text className="text-sm text-foreground">
                        <Text className="font-bold">{item.qty}×</Text> {item.name}
                      </Text>
                    </View>
                  ))}
                </View>

                {ticket.notes && (
                  <View style={{ padding: 8, borderRadius: 8, backgroundColor: '#FEF3C7', marginBottom: 12 }}>
                    <Text className="text-xs font-semibold text-amber-700">📝 {ticket.notes}</Text>
                  </View>
                )}

                {ticket.status !== 'Ready' && (
                  <TouchableOpacity onPress={() => advanceTicketStatus(ticket.id)}
                    style={{ paddingVertical: 12, borderRadius: 12, backgroundColor: color + '15', alignItems: 'center' }}
                  >
                    <Text className="text-sm font-bold" style={{ color }}>
                      Mark as {NEXT_STATUS[ticket.status]}
                    </Text>
                  </TouchableOpacity>
                )}

                {ticket.status === 'Ready' && (
                  <View style={{ paddingVertical: 12, borderRadius: 12, backgroundColor: '#10B981' + '15', alignItems: 'center' }}>
                    <Text className="text-sm font-bold" style={{ color: '#10B981' }}>✓ Ready for Service</Text>
                  </View>
                )}
              </View>
            );
          })}
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
