/**
 * Destinations Page
 * Full listing of all available destinations with experience tags
 */

import React from 'react';
import { View, Text, ScrollView, TouchableOpacity, ImageBackground } from 'react-native';
import { useRouter } from 'expo-router';
import { SafeAreaView } from 'react-native-safe-area-context';
import { Ionicons } from '@expo/vector-icons';
import { destinations } from '@/lib/mock/destinations';

export default function DestinationsPage() {
  const router = useRouter();

  const handleDestinationPress = (destination: (typeof destinations)[number]) => {
    router.push({
      pathname: '/guest-search-results',
      params: { location: destination.name, checkIn: '', checkOut: '', guests: '1' },
    });
  };

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: '#FAF6EE' }}>
      <ScrollView showsVerticalScrollIndicator={false}>
        {/* Header */}
        <View style={{ flexDirection: 'row', alignItems: 'center', padding: 16, paddingTop: 8 }}>
          <TouchableOpacity
            onPress={() => router.back()}
            style={{ width: 40, height: 40, borderRadius: 20, backgroundColor: '#FFFFFF', alignItems: 'center', justifyContent: 'center', shadowColor: '#000', shadowOffset: { width: 0, height: 1 }, shadowOpacity: 0.08, shadowRadius: 4, elevation: 2 }}
          >
            <Ionicons name="arrow-back" size={20} color="#16233A" />
          </TouchableOpacity>
          <Text style={{ fontSize: 22, fontWeight: '700', color: '#16233A', marginLeft: 12 }}>Destinations</Text>
        </View>

        {/* Subtitle */}
        <Text style={{ fontSize: 14, color: '#888', paddingHorizontal: 16, marginBottom: 20 }}>
          Explore {destinations.length} stunning destinations across Nepal
        </Text>

        {/* Destinations Grid */}
        <View style={{ paddingHorizontal: 16, paddingBottom: 32 }}>
          {destinations.map((destination) => (
            <TouchableOpacity
              key={destination.id}
              onPress={() => handleDestinationPress(destination)}
              activeOpacity={0.7}
              style={{ marginBottom: 16 }}
            >
              <View style={{ borderRadius: 16, overflow: 'hidden', backgroundColor: '#FFFFFF', shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.1, shadowRadius: 8, elevation: 3 }}>
                <ImageBackground
                  source={{ uri: destination.image }}
                  style={{ width: '100%', height: 200 }}
                  resizeMode="cover"
                >
                  <View style={{ flex: 1, backgroundColor: 'rgba(0,0,0,0.25)' }} />
                  <View style={{ position: 'absolute', bottom: 0, left: 0, right: 0, padding: 16 }}>
                    <Text style={{ color: '#FFFFFF', fontSize: 22, fontWeight: '700', marginBottom: 4 }}>
                      {destination.name}
                    </Text>
                    <Text style={{ color: 'rgba(255,255,255,0.7)', fontSize: 12, marginBottom: 8 }}>
                      {destination.hotelCount} hotels available
                    </Text>

                    {/* Experience Tags */}
                    {destination.experiences.length > 0 && (
                      <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 6 }}>
                        {destination.experiences.slice(0, 4).map((exp, idx) => (
                          <View
                            key={idx}
                            style={{ backgroundColor: 'rgba(255,255,255,0.25)', borderRadius: 12, paddingHorizontal: 10, paddingVertical: 4 }}
                          >
                            <Text style={{ color: '#FFFFFF', fontSize: 11, fontWeight: '500' }}>
                              {exp}
                            </Text>
                          </View>
                        ))}
                      </View>
                    )}
                  </View>
                </ImageBackground>
              </View>
            </TouchableOpacity>
          ))}
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}
