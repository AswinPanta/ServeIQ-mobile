import React, { useState } from 'react';
import { View, Text, TouchableOpacity, ScrollView } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';

const ACCENT = '#7C3AED';

const PLANS = [
  {
    name: 'Free', price: { monthly: 0, annual: 0 },
    features: ['Up to 1 property', 'Up to 2 users', 'Basic reporting', 'Email support'],
    subscribers: 3, color: '#6B7280',
  },
  {
    name: 'Basic', price: { monthly: 25000, annual: 270000 },
    features: ['Up to 3 properties', 'Up to 10 users', 'Revenue reports', 'Chat support', 'Basic API access'],
    subscribers: 2, color: '#3B82F6',
  },
  {
    name: 'Pro', price: { monthly: 75000, annual: 810000 },
    features: ['Up to 10 properties', 'Up to 50 users', 'Advanced analytics', 'Priority support', 'Full API access', 'Custom branding'],
    subscribers: 2, color: '#7C3AED', isCurrent: true,
  },
  {
    name: 'Enterprise', price: { monthly: null, annual: null },
    features: ['Unlimited properties', 'Unlimited users', 'Dedicated account manager', 'Custom integrations', 'SLA guarantee', 'On-premise option', '24/7 phone support'],
    subscribers: 1, color: '#F59E0B',
  },
];

export default function SubscriptionsScreen() {
  const colors = useColors();
  const [annual, setAnnual] = useState(false);

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 32 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center gap-3 mb-6">
            <TouchableOpacity onPress={() => router.back()} style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: ACCENT + '12', alignItems: 'center', justifyContent: 'center' }}>
              <Text className="text-lg" style={{ color: ACCENT }}>←</Text>
            </TouchableOpacity>
            <Text className="text-2xl font-bold text-foreground flex-1">Subscription Plans</Text>
          </View>

          <View className="flex-row items-center justify-center mb-6" style={{ backgroundColor: colors.border, borderRadius: 12, padding: 4, alignSelf: 'center' }}>
            <TouchableOpacity
              onPress={() => setAnnual(false)}
              style={{ paddingHorizontal: 20, paddingVertical: 14, borderRadius: 10, backgroundColor: annual ? 'transparent' : ACCENT }}
              activeOpacity={0.7}
            >
              <Text className="text-sm font-bold" style={{ color: annual ? colors.muted : '#FFF' }}>Monthly</Text>
            </TouchableOpacity>
            <TouchableOpacity
              onPress={() => setAnnual(true)}
              style={{ paddingHorizontal: 20, paddingVertical: 14, borderRadius: 10, backgroundColor: annual ? ACCENT : 'transparent' }}
              activeOpacity={0.7}
            >
              <Text className="text-sm font-bold" style={{ color: annual ? '#FFF' : colors.muted }}>Annual</Text>
            </TouchableOpacity>
          </View>

          {PLANS.map((plan) => {
            const price = plan.price.monthly === null ? 'Custom' : annual ? `NPR ${(plan.price.annual / 1000).toFixed(0)}K/yr` : `NPR ${(plan.price.monthly / 1000).toFixed(0)}K/mo`;
            const isFree = plan.price.monthly === 0;
            return (
              <View key={plan.name} style={{
                padding: 20, borderRadius: 20, marginBottom: 14,
                backgroundColor: colors.surface, borderWidth: plan.isCurrent ? 2 : 1,
                borderColor: plan.isCurrent ? ACCENT : colors.border,
                shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 8, elevation: 2,
              }}>
                <View className="flex-row items-center justify-between mb-3">
                  <Text className="text-xl font-bold text-foreground">{plan.name}</Text>
                  <View style={{ flexDirection: 'row', gap: 6 }}>
                    {plan.isCurrent && (
                      <View style={{ paddingHorizontal: 12, paddingVertical: 8, borderRadius: 8, backgroundColor: ACCENT + '15' }}>
                        <Text className="text-xs font-bold" style={{ color: ACCENT }}>Current</Text>
                      </View>
                    )}
                    <View style={{ paddingHorizontal: 12, paddingVertical: 8, borderRadius: 8, backgroundColor: '#10B98115' }}>
                      <Text className="text-xs font-bold text-green-500">{plan.subscribers} active</Text>
                    </View>
                  </View>
                </View>

                <Text className="text-3xl font-bold text-foreground mb-4">
                  {price}
                </Text>

                <View style={{ height: 1, backgroundColor: colors.border, marginBottom: 14 }} />

                {plan.features.map((feat, i) => (
                  <View key={i} className="flex-row items-center gap-2 mb-2">
                    <Text style={{ color: ACCENT, fontSize: 14 }}>✓</Text>
                    <Text className="text-sm text-foreground">{feat}</Text>
                  </View>
                ))}

                {!isFree && (
                  <TouchableOpacity
                    style={{ marginTop: 14, paddingVertical: 14, borderRadius: 12, backgroundColor: plan.isCurrent ? colors.border : ACCENT, alignItems: 'center' }}
                    activeOpacity={0.7}
                    disabled={plan.isCurrent}
                  >
                    <Text className="text-base font-bold" style={{ color: plan.isCurrent ? colors.muted : '#FFF' }}>
                      {plan.isCurrent ? 'Current Plan' : `Upgrade to ${plan.name}`}
                    </Text>
                  </TouchableOpacity>
                )}
                {isFree && (
                  <View style={{ marginTop: 14, paddingVertical: 14, borderRadius: 12, backgroundColor: colors.border, alignItems: 'center' }}>
                    <Text className="text-base font-bold text-muted">Current Plan</Text>
                  </View>
                )}
              </View>
            );
          })}
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
