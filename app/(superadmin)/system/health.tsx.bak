import React from 'react';
import { View, Text, TouchableOpacity, ScrollView } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';

const ACCENT = '#7C3AED';

const SERVICES = [
  { name: 'API Server', status: 'Operational', uptime: '99.97%', response: '45ms', lastIncident: '2025-04-15', color: '#10B981' },
  { name: 'Database', status: 'Operational', uptime: '99.99%', response: '12ms', lastIncident: '2025-03-22', color: '#10B981' },
  { name: 'Cache (Redis)', status: 'Operational', uptime: '99.95%', response: '3ms', lastIncident: '2025-05-10', color: '#10B981' },
  { name: 'File Storage', status: 'Degraded', uptime: '98.50%', response: '320ms', lastIncident: '2025-06-28', color: '#F59E0B' },
  { name: 'Email Service', status: 'Operational', uptime: '99.88%', response: '210ms', lastIncident: '2025-06-20', color: '#10B981' },
  { name: 'Payment Gateway', status: 'Operational', uptime: '99.92%', response: '180ms', lastIncident: '2025-06-15', color: '#10B981' },
];

const RECENT_INCIDENTS = [
  { title: 'File Storage Slow Response', date: '2025-06-28', status: 'Resolved', duration: '1h 23m' },
  { title: 'Email Delivery Delay', date: '2025-06-20', status: 'Resolved', duration: '45m' },
  { title: 'Payment Gateway Timeout', date: '2025-06-15', status: 'Resolved', duration: '32m' },
  { title: 'Database Connection Pool Exhaustion', date: '2025-05-10', status: 'Resolved', duration: '2h 10m' },
];

const STATUS_MAP = {
  Operational: { bg: '#10B98115', text: '#10B981', label: 'Operational' },
  Degraded: { bg: '#F59E0B15', text: '#F59E0B', label: 'Degraded' },
  Down: { bg: '#EF444415', text: '#EF4444', label: 'Down' },
};

export default function HealthScreen() {
  const colors = useColors();
  const overallStatus = 'Degraded Performance';

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 32 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center gap-3 mb-6">
            <TouchableOpacity onPress={() => router.back()} style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: ACCENT + '12', alignItems: 'center', justifyContent: 'center' }}>
              <Text className="text-lg" style={{ color: ACCENT }}>←</Text>
            </TouchableOpacity>
            <Text className="text-2xl font-bold text-foreground flex-1">System Health</Text>
          </View>

          <View style={{ padding: 20, borderRadius: 20, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 8, elevation: 2, marginBottom: 16 }}>
            <View className="flex-row items-center gap-3 mb-2">
              <View style={{ width: 16, height: 16, borderRadius: 8, backgroundColor: '#F59E0B' }} />
              <Text className="text-lg font-bold text-foreground">{overallStatus}</Text>
            </View>
            <Text className="text-sm text-muted">1 service experiencing degraded performance</Text>
          </View>

          {SERVICES.map((svc) => {
            const statusInfo = STATUS_MAP[svc.status as keyof typeof STATUS_MAP] || STATUS_MAP.Operational;
            return (
              <View key={svc.name} style={{
                padding: 16, borderRadius: 16, marginBottom: 10,
                backgroundColor: colors.surface,
                shadowColor: '#000', shadowOffset: { width: 0, height: 1 }, shadowOpacity: 0.04, shadowRadius: 6, elevation: 1,
              }}>
                <View className="flex-row items-center justify-between mb-3">
                  <View className="flex-row items-center gap-2">
                    <View style={{ width: 10, height: 10, borderRadius: 5, backgroundColor: svc.color }} />
                    <Text className="text-base font-bold text-foreground">{svc.name}</Text>
                  </View>
                  <View style={{ paddingHorizontal: 12, paddingVertical: 4, borderRadius: 8, backgroundColor: statusInfo.bg }}>
                    <Text className="text-xs font-bold" style={{ color: statusInfo.text }}>{statusInfo.label}</Text>
                  </View>
                </View>
                <View className="flex-row gap-4">
                  <View>
                    <Text className="text-xs text-muted">Uptime</Text>
                    <Text className="text-sm font-bold text-foreground">{svc.uptime}</Text>
                  </View>
                  <View>
                    <Text className="text-xs text-muted">Response</Text>
                    <Text className="text-sm font-bold text-foreground">{svc.response}</Text>
                  </View>
                  <View>
                    <Text className="text-xs text-muted">Last Incident</Text>
                    <Text className="text-sm font-bold text-foreground">{svc.lastIncident}</Text>
                  </View>
                </View>
              </View>
            );
          })}

          <View style={{ padding: 20, borderRadius: 20, backgroundColor: colors.surface, shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 8, elevation: 2, marginTop: 4 }}>
            <Text className="text-lg font-bold text-foreground mb-4">Recent Incidents</Text>
            {RECENT_INCIDENTS.map((inc, i) => (
              <View key={inc.title} style={{ flexDirection: 'row', alignItems: 'center', paddingVertical: 12, borderBottomWidth: i < RECENT_INCIDENTS.length - 1 ? 1 : 0, borderBottomColor: colors.border, gap: 10 }}>
                <View style={{ width: 8, height: 8, borderRadius: 4, backgroundColor: '#10B981' }} />
                <View className="flex-1">
                  <Text className="text-sm font-semibold text-foreground">{inc.title}</Text>
                  <Text className="text-xs text-muted">{inc.date} • Duration: {inc.duration}</Text>
                </View>
                <View style={{ paddingHorizontal: 8, paddingVertical: 4, borderRadius: 6, backgroundColor: '#10B98115' }}>
                  <Text className="text-xs font-bold text-green-500">{inc.status}</Text>
                </View>
              </View>
            ))}
          </View>
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
