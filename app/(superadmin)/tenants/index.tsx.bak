import React, { useState } from 'react';
import { View, Text, TextInput, TouchableOpacity, ScrollView } from 'react-native';
import { router } from 'expo-router';
import { ScreenContainer } from '@/components/screen-container';
import { useColors } from '@/hooks/use-colors';

const ACCENT = '#7C3AED';

const FILTERS = ['All', 'Active', 'Suspended', 'Trial'] as const;

const TENANTS = [
  { id: '1', company: 'Himalayan Heights Hotels', plan: 'Enterprise', status: 'Active', properties: 8, users: 24, mrr: 120000, email: 'info@himalayanheights.com', phone: '+977-1-4XXXXXX', address: 'Thamel, Kathmandu', created_at: '2024-01-15', avatar: 'HH' },
  { id: '2', company: 'Pokhara Lake Resort', plan: 'Pro', status: 'Active', properties: 3, users: 10, mrr: 75000, email: 'hello@pokharalake.com', phone: '+977-61-4XXXXX', address: 'Lakeside, Pokhara', created_at: '2024-03-20', avatar: 'PL' },
  { id: '3', company: 'Buddha B&B Chain', plan: 'Basic', status: 'Active', properties: 2, users: 5, mrr: 25000, email: 'info@buddhabb.com', phone: '+977-1-5XXXXXX', address: 'Boudha, Kathmandu', created_at: '2024-06-10', avatar: 'BB' },
  { id: '4', company: 'Chitwan Safari Lodge', plan: 'Basic', status: 'Suspended', properties: 1, users: 3, mrr: 0, email: 'admin@chitwansafari.com', phone: '+977-56-4XXXXX', address: 'Sauraha, Chitwan', created_at: '2024-02-01', avatar: 'CS' },
  { id: '5', company: 'Mountain View Inn', plan: 'Trial', status: 'Trial', properties: 1, users: 2, mrr: 0, email: 'info@mountainviewinn.com', phone: '+977-61-5XXXXX', address: 'Sarangkot, Pokhara', created_at: '2025-06-01', avatar: 'MV' },
  { id: '6', company: 'Lumbini Garden Hotel', plan: 'Pro', status: 'Active', properties: 4, users: 14, mrr: 75000, email: 'contact@lumbinigarden.com', phone: '+977-71-4XXXXX', address: 'Lumbini', created_at: '2024-04-05', avatar: 'LG' },
  { id: '7', company: 'Everest Base Camp Lodges', plan: 'Enterprise', status: 'Active', properties: 6, users: 18, mrr: 120000, email: 'ops@everestlodges.com', phone: '+977-1-6XXXXXX', address: 'Durbar Marg, Kathmandu', created_at: '2023-11-01', avatar: 'EB' },
  { id: '8', company: 'Garden Retreat', plan: 'Trial', status: 'Trial', properties: 1, users: 1, mrr: 0, email: 'owner@gardenretreat.com', phone: '+977-1-7XXXXXX', address: 'Patan, Lalitpur', created_at: '2025-06-15', avatar: 'GR' },
];

const STATUS_STYLES: Record<string, { bg: string; text: string }> = {
  Active: { bg: '#10B98115', text: '#10B981' },
  Suspended: { bg: '#EF444415', text: '#EF4444' },
  Trial: { bg: '#F59E0B15', text: '#F59E0B' },
};

export default function TenantsScreen() {
  const colors = useColors();
  const [search, setSearch] = useState('');
  const [activeFilter, setActiveFilter] = useState<string>('All');

  const filtered = TENANTS.filter((t) => {
    const matchSearch = t.company.toLowerCase().includes(search.toLowerCase());
    const matchFilter = activeFilter === 'All' || t.status === activeFilter;
    return matchSearch && matchFilter;
  });

  return (
    <ScreenContainer containerClassName="bg-background" className="flex-1">
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 32 }}>
        <View className="px-6 pt-14 pb-4">
          <View className="flex-row items-center gap-3 mb-6">
            <TouchableOpacity onPress={() => router.back()} style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: ACCENT + '12', alignItems: 'center', justifyContent: 'center' }}>
              <Text className="text-lg" style={{ color: ACCENT }}>←</Text>
            </TouchableOpacity>
            <View>
              <Text className="text-2xl font-bold text-foreground">Tenants</Text>
              <Text className="text-sm text-muted">{filtered.length} total</Text>
            </View>
          </View>

          <View style={{ flexDirection: 'row', alignItems: 'center', backgroundColor: colors.border, borderRadius: 14, paddingHorizontal: 14, height: 46, marginBottom: 14 }}>
            <Text style={{ fontSize: 16, marginRight: 8, opacity: 0.5 }}>🔍</Text>
            <TextInput
              placeholder="Search tenants..."
              placeholderTextColor={colors.muted}
              value={search}
              onChangeText={setSearch}
              className="flex-1 text-base text-foreground"
            />
          </View>

          <ScrollView horizontal showsHorizontalScrollIndicator={false} className="mb-5">
            <View className="flex-row gap-2">
              {FILTERS.map((f) => (
                <TouchableOpacity
                  key={f}
                  onPress={() => setActiveFilter(f)}
                  style={{
                    paddingHorizontal: 18, paddingVertical: 14, borderRadius: 20,
                    backgroundColor: activeFilter === f ? ACCENT : colors.border,
                  }}
                  activeOpacity={0.7}
                >
                  <Text className="text-sm font-semibold" style={{ color: activeFilter === f ? '#FFF' : colors.muted }}>{f}</Text>
                </TouchableOpacity>
              ))}
            </View>
          </ScrollView>

          {filtered.map((tenant) => {
            const statusStyle = STATUS_STYLES[tenant.status];
            return (
              <TouchableOpacity
                key={tenant.id}
                onPress={() => router.push(`/(superadmin)/tenants/${tenant.id}`)}
                style={{
                  padding: 16, borderRadius: 16, marginBottom: 12,
                  backgroundColor: colors.surface,
                  shadowColor: '#000', shadowOffset: { width: 0, height: 2 }, shadowOpacity: 0.05, shadowRadius: 8, elevation: 2,
                }}
                activeOpacity={0.7}
              >
                <View className="flex-row items-center gap-3 mb-3">
                  <View style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: ACCENT + '18', alignItems: 'center', justifyContent: 'center' }}>
                    <Text className="text-sm font-bold" style={{ color: ACCENT }}>{tenant.avatar}</Text>
                  </View>
                  <View className="flex-1">
                    <Text className="text-base font-bold text-foreground">{tenant.company}</Text>
                    <Text className="text-xs text-muted">{tenant.plan}</Text>
                  </View>
                  <View style={{ paddingHorizontal: 12, paddingVertical: 4, borderRadius: 8, backgroundColor: statusStyle.bg }}>
                    <Text className="text-xs font-bold" style={{ color: statusStyle.text }}>{tenant.status}</Text>
                  </View>
                </View>
                <View className="flex-row gap-4">
                  <View className="flex-row items-center gap-1">
                    <Text style={{ fontSize: 12 }}>🏨</Text>
                    <Text className="text-xs text-muted">{tenant.properties}</Text>
                  </View>
                  <View className="flex-row items-center gap-1">
                    <Text style={{ fontSize: 12 }}>👥</Text>
                    <Text className="text-xs text-muted">{tenant.users}</Text>
                  </View>
                  <View className="flex-row items-center gap-1">
                    <Text style={{ fontSize: 12 }}>💰</Text>
                    <Text className="text-xs font-bold" style={{ color: ACCENT }}>NPR {tenant.mrr.toLocaleString()}</Text>
                  </View>
                </View>
              </TouchableOpacity>
            );
          })}
        </View>
      </ScrollView>
    </ScreenContainer>
  );
}
